{
  "openapi": "3.1.0",
  "info": { "title": "Example shop API", "version": "1.0.0" },
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/health": {
      "get": { "summary": "Health check", "security": [], "responses": { "200": { "description": "OK" } } }
    },
    "/tenants/{tenantId}/invoices/{invoiceId}": {
      "get": { "summary": "Read invoice", "responses": { "200": { "description": "Invoice" } } },
      "delete": { "summary": "Delete invoice", "responses": { "204": { "description": "Deleted" } } }
    },
    "/invoices": {
      "get": {
        "summary": "List invoices",
        "parameters": [{ "name": "accountId", "in": "query", "schema": { "type": "string" } }],
        "responses": { "200": { "description": "List" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer" }
    }
  }
}
